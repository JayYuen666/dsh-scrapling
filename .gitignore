node_modules/
client.js
.toolchain/
host.js
coverage/
# 覆盖率数据文件：cov:py 的聚合结果，以及 py/ 下子进程留下的那一份。
# 不忽略的话每次跑完覆盖率都多出几个未跟踪文件，还容易被误提交。
.coverage
.coverage.*
*.tsbuildinfo
.DS_Store

# Scrapling 的 adaptive 指纹库三件套。sidecar 以部署的 dataDir 为工作目录时才该落在
# 用户机器上；一旦有测试或探针以仓库根为 cwd 跑 select(adaptive=True)，SQLite 就会在
# 这里建库 —— 那是运行时状态，不是源码，而且会把用户的选择器指纹误提交出去。
elements_storage.db
elements_storage.db-wal
elements_storage.db-shm

# Python 字节码缓存（构建产物）
py/__pycache__/
__pycache__/

# 探针脚本用的虚拟环境：404MB，机器本地状态，不入库
_env/.venv/

# 本地环境文件：机器相关、常带密钥，只放行模板
.env
.env.*
!.env.example

# 运行期日志（工具会追加写，内容随机器与调用变化）
*.log

# Python 工具链缓存：ruff / mypy 会在各自的缓存目录里写一份 `*` 的 .gitignore，
# 所以它们在 `git status` 里本就不出现；pytest 与打包产物没有这层自忽略，得在这里挡。
.pytest_cache/
*.egg-info/

