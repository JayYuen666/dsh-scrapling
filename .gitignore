node_modules/
client.js
.toolchain/
host.js
coverage/
# 覆盖率数据文件：cov:py 的聚合结果，以及 py/ 下子进程留下的那一份。
# 不忽略的话每次跑完覆盖率都多出几个未跟踪文件，还容易被误提交。
.coverage
.coverage.*
*.tsbuildinfo
.DS_Store

# Python 字节码缓存（构建产物）
py/__pycache__/
__pycache__/

# 探针脚本用的虚拟环境：404MB，机器本地状态，不入库
_env/.venv/

# 本机 npm 配置：实测含 _authToken 行，属凭据，绝不入库
.npmrc
